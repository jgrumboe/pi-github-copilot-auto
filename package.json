{
  "name": "pi-github-copilot-auto",
  "version": "0.2.0",
  "description": "Adds github-copilot-auto/auto models to pi that follow GitHub Copilot's server-side auto model selection via the single-call AutoV2 router (POST /auto), with routing-tier support.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "github-copilot",
    "copilot",
    "ai"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "index.ts",
    ".npmrc",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jgrumboe/pi-github-copilot-auto.git"
  },
  "homepage": "https://github.com/jgrumboe/pi-github-copilot-auto#readme",
  "bugs": {
    "url": "https://github.com/jgrumboe/pi-github-copilot-auto/issues"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
