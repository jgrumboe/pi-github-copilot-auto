{
  "name": "pi-github-copilot-auto",
  "version": "0.4.0",
  "description": "Adds separate GitHub Copilot Auto and opt-in Fusion Standard models to pi, using Copilot's server-side POST /auto router.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "github-copilot",
    "copilot-fusion",
    "copilot",
    "ai"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "index.ts",
    "auto-identity.ts",
    ".npmrc",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jgrumboe/pi-github-copilot-auto.git"
  },
  "homepage": "https://github.com/jgrumboe/pi-github-copilot-auto#readme",
  "bugs": {
    "url": "https://github.com/jgrumboe/pi-github-copilot-auto/issues"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:current": "vitest run --config vitest.current.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.74.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.19.0",
    "pi-ai-current": "npm:@earendil-works/pi-ai@0.85.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
